# Copy to .env and fill in. The backend also reads process env vars.
ENVIRONMENT=development

# Frozen Zendesk store (defaults to ../data/raw/zendesk); override in Docker.
# DATA_DIR=/app/data/raw/zendesk

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]
